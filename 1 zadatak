#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>

typedef struct _Student {
    char name[20];
    char surn[20];
    int poin;
} stud;

int main() {
    int brojac = 0;
    int i = 0;

    stud* Studenti = NULL;
    char buffer[50] = {0};

    FILE* fp = fopen("list.txt", "r");

    if (!fp) {
        printf("Error!!!!\n");
        return -1;
    }

    while (fgets(buffer, 50, fp) != NULL) {
        brojac++;
    }

    fclose(fp);

    Studenti = (stud*)malloc(brojac * sizeof(stud));

    if (!Studenti) {
        printf("Error!!!\n");
        return -2;
    }

    fp = fopen("list.txt", "r");

    if (!fp) {
        printf("Error!!!!\n");
        free(Studenti);
        return -1;
    }

    while (i < brojac) {
        fscanf(fp, "%s %s %d", Studenti[i].name, Studenti[i].surn, &Studenti[i].poin);
        i++;
    }

    printf("\nIme\t\tPrezime\t\tBodovi\tRelativni bodovi\n");

    for (i = 0; i < brojac; i++) {
        float relativni_bodovi =
            (float)Studenti[i].poin / 30 * 100;

        printf("%s\t\t%s\t\t%d\t%.2f%%\n", Studenti[i].name, Studenti[i].surn, Studenti[i].poin, relativni_bodovi);
    }

    free(Studenti);
    fclose(fp);

    return 0;
}
